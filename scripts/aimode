#!/usr/bin/env python3
"""aimode: terminal Q&A using Gemini with Google Search grounding. Stdlib only.
Usage: aimode "question"   one-shot
       aimode              full-screen TUI, keeps conversation context
       aimode --plain      simple prompt loop
       aimode --search     enable Google Search grounding (needs billing on the key)
       aimode --models     list model IDs usable with AIMODE_MODEL
Env:   GEMINI_API_KEY (or ~/.config/aimode/key), AIMODE_MODEL (default gemini-3.8-flash)
"""
import json, os, sys, time, urllib.request, urllib.error
try:
    import readline  # noqa: F401  line editing and history
except ImportError:
    pass

MODEL = os.environ.get("AIMODE_MODEL", "gemini-3.8-flash")
URL = "https://generativelanguage.googleapis.com/v1beta/models/%s:streamGenerateContent?alt=sse"
SEARCH = "--search" in sys.argv  # grounding needs a billed key; free tier is training data only
FALLBACK_MODEL = "gemini-3.1-flash-lite"
TIMEOUT = 45  # seconds without data before giving up on a model
MODELS_URL = "https://generativelanguage.googleapis.com/v1beta/models?pageSize=200"
BOLD, DIM, RST = ("\033[1m", "\033[2m", "\033[0m") if sys.stdout.isatty() else ("", "", "")


def get_key():
    k = os.environ.get("GEMINI_API_KEY")
    if not k:
        try:
            k = open(os.path.expanduser("~/.config/aimode/key")).read().strip()
        except OSError:
            sys.exit("No key. Set GEMINI_API_KEY or write it to ~/.config/aimode/key")
    return k


def stream(history, key, model=None):
    """On a 503 retry once with FALLBACK_MODEL. Yield ("text", str), ("src", (uri, title)) and finally ("err", msg) on failure."""
    body = {"contents": history}
    if SEARCH:
        body["tools"] = [{"google_search": {}}]
    body = json.dumps(body).encode()
    req = urllib.request.Request(URL % (model or MODEL), body,
                                 {"Content-Type": "application/json", "x-goog-api-key": key})
    got = False  # once text has streamed a fallback would duplicate it
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            for line in r:
                if not line.startswith(b"data: "):
                    continue
                cand = json.loads(line[6:]).get("candidates", [{}])[0]
                for p in cand.get("content", {}).get("parts", []):
                    if p.get("text"):
                        got = True
                        yield "text", p["text"]
                for c in cand.get("groundingMetadata", {}).get("groundingChunks", []):
                    w = c.get("web", {})
                    if w.get("uri"):
                        yield "src", (w["uri"], w.get("title", ""))
    except urllib.error.HTTPError as e:
        if e.code == 503 and not got and not model and MODEL != FALLBACK_MODEL:
            yield "note", "%s is overloaded (503), using %s" % (MODEL, FALLBACK_MODEL)
            yield from stream(history, key, FALLBACK_MODEL)
            return
        yield "err", "HTTP %d: %s%s" % (e.code, e.read().decode(errors="replace")[:500],
                                        {404: " (try aimode --models)", 429: " (quota; search may need billing, try --no-search)"}.get(e.code, ""))
    except Exception as e:
        if not got and not model and MODEL != FALLBACK_MODEL and "timed out" in str(e):
            yield "note", "%s did not answer in %ds, using %s" % (MODEL, TIMEOUT, FALLBACK_MODEL)
            yield from stream(history, key, FALLBACK_MODEL)
            return
        yield "err", "%s (waited up to %ds)" % (e, TIMEOUT) if "timed out" in str(e) else str(e)


def ask(history, key):
    """Plain mode: stream one answer to stdout, return the text."""
    text, sources = "", {}
    for kind, v in stream(history, key):
        if kind == "text":
            text += v
            print(v, end="", flush=True)
        elif kind == "src":
            sources[v[0]] = v[1]
        elif kind == "note":
            print(DIM + "[" + v + "]" + RST, file=sys.stderr)
        else:
            sys.exit("\n" + v)
    print()
    if sources:
        print(DIM + "Sources:")
        for i, (u, t) in enumerate(sources.items(), 1):
            print(" [%d] %s %s" % (i, t, u))
        print(RST, end="")
    return text


def tui(scr, key):
    import curses, queue, textwrap, threading
    curses.raw()  # Ctrl+C and Ctrl+Q arrive as keys instead of a signal or flow control
    curses.curs_set(1)
    curses.use_default_colors()
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    scr.timeout(50)
    scr.keypad(True)
    entries = []          # [style, text]; style in u (user), a (answer), s (source), e (error)
    history, buf, off, q, busy = [], "", 0, queue.Queue(), False
    ESCAPES = {"[1~": curses.KEY_HOME, "[7~": curses.KEY_HOME, "[H": curses.KEY_HOME, "OH": curses.KEY_HOME,
               "[4~": curses.KEY_END, "[8~": curses.KEY_END, "[F": curses.KEY_END, "OF": curses.KEY_END,
               "[3~": curses.KEY_DC, "[5~": curses.KEY_PPAGE, "[6~": curses.KEY_NPAGE}
    SCROLL_BOTTOM = 0x10001  # synthetic key sent by the Bottom button
    t0, cur = 0, 0  # cur: cursor position inside buf
    asked, hidx, draft = [], 0, ""   # question recall: Up/Down walk earlier questions
    BUTTONS = [("PgUp", curses.KEY_PPAGE), ("PgDn", curses.KEY_NPAGE), ("Bottom", SCROLL_BOTTOM),
               ("New ^N", "\x0e"), ("Quit ^Q", "\x11")]
    attr = {"u": curses.A_BOLD, "a": 0, "s": curses.A_DIM, "e": curses.A_REVERSE}

    def worker(h):
        text = ""
        for kind, v in stream(h, key):
            if kind == "text":
                text += v
            q.put((kind, v))
        q.put(("done", text))

    def vlines(w):
        out = []
        for st, t in entries:
            for ln in (("> " + t) if st == "u" else t).split("\n"):
                for piece in textwrap.wrap(ln, w, drop_whitespace=False, replace_whitespace=False) or [""]:
                    out.append((st, piece))
        return out

    srcs = []
    while True:
        try:  # the pty size is authoritative, a resize may arrive without SIGWINCH
            size = os.get_terminal_size(sys.stdout.fileno())
            if (size.lines, size.columns) != scr.getmaxyx():
                curses.resizeterm(size.lines, size.columns)
                scr.clear()
        except OSError:
            pass
        h, w = scr.getmaxyx()
        ph = max(1, h - 2)  # rows 0..h-3 transcript, h-2 input, h-1 buttons
        while True:
            try:
                kind, v = q.get_nowait()
            except queue.Empty:
                break
            if kind == "text":
                if entries and entries[-1][0] == "a" and busy:
                    entries[-1][1] += v
                else:
                    entries.append(["a", v])
            elif kind == "src":
                if v[0] not in [u for u, _ in srcs]:
                    srcs.append(v)
            elif kind == "note":
                entries.append(["s", "[" + v + "]"])
            elif kind == "err":
                entries.append(["e", v])
            elif kind == "done":
                if v:
                    history.append({"role": "model", "parts": [{"text": v}]})
                if srcs:
                    entries.append(["s", "\n".join(" [%d] %s %s" % (i, t, u) for i, (u, t) in enumerate(srcs, 1))])
                busy = False
        vis = vlines(w - 1)
        off = max(0, min(off, len(vis) - ph))
        end = len(vis) - off
        scr.erase()
        for i, (st, t) in enumerate(vis[max(0, end - ph):end]):
            try:
                scr.addstr(i, 0, t, attr[st])
            except curses.error:
                pass
        btns, x = [], 0
        for label, k in BUTTONS:
            t = " %s " % label
            try:
                scr.addstr(h - 1, x, t, curses.A_REVERSE)
            except curses.error:
                pass
            btns.append((x, x + len(t), k))
            x += len(t) + 1
        info = "%s %s%s%s" % (MODEL, "[search]" if SEARCH else "[no search]",
                              " | thinking %ds..." % (time.time() - t0) if busy else "", " | up %d" % off if off else "")
        try:
            scr.addstr(h - 1, x + 1, info[:max(0, w - x - 2)], curses.A_DIM)
        except curses.error:
            pass
        try:
            avail = max(1, w - 3)
            start = max(0, cur - avail + 1)  # scroll the line sideways to keep the cursor visible
            scr.addstr(h - 2, 0, "> " + buf[start:start + avail])
            scr.move(h - 2, 2 + cur - start)
        except curses.error:
            pass
        scr.refresh()
        try:
            c = scr.get_wch()
        except curses.error:
            continue
        if c == curses.KEY_RESIZE:
            scr.clear()
            continue
        if c == "\x1b":  # escape sequence curses did not decode (terminal and TERM disagree)
            seq = ""
            scr.timeout(0)
            while len(seq) < 4:
                try:
                    x = scr.get_wch()
                except curses.error:
                    break
                if not isinstance(x, str):
                    break
                seq += x
            scr.timeout(50)
            c = ESCAPES.get(seq)
            if c is None:
                continue
        if c == curses.KEY_MOUSE:
            try:
                _, mx, my, _, b = curses.getmouse()
            except curses.error:
                continue
            if b & curses.BUTTON4_PRESSED:
                off += 3
                continue
            if b & getattr(curses, "BUTTON5_PRESSED", 0x200000):
                off -= 3
                continue
            c = None
            if b & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED) and my == h - 1:
                c = next((k for x0, x1, k in btns if x0 <= mx < x1), None)
            if c is None:
                continue
        if c in (curses.KEY_PPAGE,):
            off += ph - 1
        elif c in (curses.KEY_NPAGE,):
            off -= ph - 1
        elif c == curses.KEY_UP and asked:
            if hidx == len(asked):
                draft = buf
            hidx = max(0, hidx - 1)
            buf = asked[hidx]
            cur = len(buf)
        elif c == curses.KEY_DOWN and hidx < len(asked):
            hidx += 1
            buf = asked[hidx] if hidx < len(asked) else draft
            cur = len(buf)
        elif c == SCROLL_BOTTOM:
            off = 0
        elif c == curses.KEY_LEFT:
            cur = max(0, cur - 1)
        elif c == curses.KEY_RIGHT:
            cur = min(len(buf), cur + 1)
        elif c in (curses.KEY_HOME, "\x01"):
            cur = 0
        elif c in (curses.KEY_END, "\x05"):
            cur = len(buf)
        elif c == curses.KEY_DC:
            buf = buf[:cur] + buf[cur + 1:]
        elif c == "\x0b":
            buf = buf[:cur]
        elif c == "\x17":
            i = cur
            while i and buf[i - 1] == " ":
                i -= 1
            while i and buf[i - 1] != " ":
                i -= 1
            buf, cur = buf[:i] + buf[cur:], i
        elif c in ("\x03", "\x11"):
            return
        elif c == "\x0e":
            history.clear(); entries.clear(); off = 0
        elif c in ("\x15",):
            buf, cur = "", 0
        elif c in ("\x7f", "\b", curses.KEY_BACKSPACE):
            if cur:
                buf, cur = buf[:cur - 1] + buf[cur:], cur - 1
        elif c == "\n" and buf.strip() in ("/quit", "/q"):
            return
        elif c == "\n" and buf.strip() and not busy:
            history.append({"role": "user", "parts": [{"text": buf.strip()}]})
            asked.append(buf.strip())
            hidx, draft = len(asked), ""
            entries.append(["u", buf.strip()])
            entries.append(["a", ""])
            buf, cur, off, busy, srcs, t0 = "", 0, 0, True, [], time.time()
            threading.Thread(target=worker, args=(list(history),), daemon=True).start()
        elif isinstance(c, str) and c.isprintable():
            buf, cur = buf[:cur] + c + buf[cur:], cur + 1


def list_models(key):
    req = urllib.request.Request(MODELS_URL, headers={"x-goog-api-key": key})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            for m in json.load(r).get("models", []):
                if "generateContent" in m.get("supportedGenerationMethods", []):
                    print(m["name"].removeprefix("models/"))
    except urllib.error.HTTPError as e:
        sys.exit("HTTP %d: %s" % (e.code, e.read().decode(errors="replace")[:500]))


def main():
    key = get_key()
    if "--models" in sys.argv:
        return list_models(key)
    args = [a for a in sys.argv[1:] if a not in ("--plain", "--search", "--no-search")]
    if not args and "--plain" not in sys.argv and sys.stdin.isatty() and sys.stdout.isatty():
        import curses, locale
        locale.setlocale(locale.LC_ALL, "")
        try:
            curses.wrapper(tui, key)
        except KeyboardInterrupt:
            pass
        return
    history = []

    def turn(q):
        history.append({"role": "user", "parts": [{"text": q}]})
        a = ask(history, key)
        history.append({"role": "model", "parts": [{"text": a}]})

    if args:
        turn(" ".join(args))
        return
    print("%saimode%s (%s). /new clears context, /quit or Ctrl+C exits." % (BOLD, RST, MODEL))
    while True:
        try:
            q = input(BOLD + "> " + RST).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if q in ("/quit", "/q"):
            break
        if q == "/new":
            history.clear()
            continue
        if q:
            turn(q)


if __name__ == "__main__":
    main()
